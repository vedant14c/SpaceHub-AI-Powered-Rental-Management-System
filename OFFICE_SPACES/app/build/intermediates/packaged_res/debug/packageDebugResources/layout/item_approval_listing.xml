<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgProperty"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@color/lightBlue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Square"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/textDark" />

            <TextView
                android:id="@+id/txtOwnerAndLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Andheri East, Mumbai"
                android:textSize="12sp"
                android:textColor="@color/textGray"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹45,000 / month"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnApprove"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_status_active"
                android:src="@drawable/ic_approvals"
                android:padding="8dp"/>

            <ImageButton
                android:id="@+id/btnReject"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_cancelled"
                android:src="@drawable/ic_block"
                android:padding="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_status_active"
            android:textColor="@color/textDark"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
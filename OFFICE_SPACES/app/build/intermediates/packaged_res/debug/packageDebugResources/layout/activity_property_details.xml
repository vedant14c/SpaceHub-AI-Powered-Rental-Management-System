<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom action bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="14dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_role_card"
            android:src="@drawable/ic_call"
            android:padding="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:text="Message"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_message"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Book Now"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="10dp"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/lightBlue"/>

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_role_card"
                    android:src="@drawable/arrow_back"
                    android:padding="8dp"/>

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_role_card"
                    android:src="@drawable/ic_heart_outline"
                    android:padding="8dp"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Business Square"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/textDark"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star"/>

                        <TextView
                            android:id="@+id/txtRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.5 (120)"
                            android:textSize="13sp"
                            android:textColor="@color/textDark"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Andheri East, Mumbai"
                    android:textColor="@color/textGray"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹45,000 / month"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/txtMaintenance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maintenance ₹5,000"
                    android:textColor="@color/textGray"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <!-- Stats row (Area/Type/Floor/Listing — mapped to real backend fields) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_role_card"
                    android:padding="14dp"
                    android:layout_marginTop="16dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_area"/>
                        <TextView android:id="@+id/txtStatArea" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1500" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sq Ft" android:textSize="11sp" android:textColor="@color/textGray"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_furnished"/>
                        <TextView android:id="@+id/txtStatType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Office" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type" android:textSize="11sp" android:textColor="@color/textGray"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_seats"/>
                        <TextView android:id="@+id/txtStatFloor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 / 10" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Floor" android:textSize="11sp" android:textColor="@color/textGray"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Property"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textDark"
                    android:layout_marginTop="22dp"/>

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modern office space with excellent connectivity and amenities."
                    android:textColor="@color/textGray"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amenities"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textDark"
                    android:layout_marginTop="20dp"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"/>

                <!-- Location section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/textDark"
                    android:layout_marginTop="22dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/textGray"/>

                    <TextView
                        android:id="@+id/txtFullAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Address not available"
                        android:textColor="@color/textGray"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDistanceAway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- km away"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <fragment
                            android:id="@+id/mapPreviewFragment"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <!-- Transparent overlay so a tap opens full navigation instead of interacting with the mini map -->
                        <View
                            android:id="@+id/mapPreviewOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"/>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetDirections"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="Get Directions"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    app:icon="@drawable/ic_location_pin"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>